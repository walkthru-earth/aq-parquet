{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://walkthru-earth.github.io/opensensor-space-firmware/plugins/v0.1.0/lock.json#",
  "title": "OpenSensor shipped.lock",
  "description": "Append only record of every released dictionary of one board variant, oldest first, with the FIELD rows of each segment hashed.",
  "type": "object",
  "required": ["board", "releases"],
  "properties": {
    "board": {"$ref": "board.json#/properties/board"},
    "releases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["dict", "rows", "segments"],
        "properties": {
          "dict": {"$ref": "#/definitions/sha256"},
          "rows": {"type": "integer", "minimum": 1},
          "segments": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["module", "segment", "first", "rows", "sha256"],
              "properties": {
                "module": {"$ref": "module.json#/definitions/id"},
                "segment": {"$ref": "module.json#/definitions/id"},
                "first": {"type": "integer", "minimum": 1},
                "rows": {"type": "integer", "minimum": 1},
                "sha256": {"$ref": "#/definitions/sha256"}
              },
              "additionalProperties": false
            }
          },
          "baseline": {
            "description": "Present only on an owner approved break. Such a release may edit only the shipped segments it lists in segments, and it must edit each one it lists. It names the reason and the exact heading of its docs/shared/mobile-migration.md entry, and that entry must name its dict.",
            "type": "object",
            "required": ["reason", "migration", "segments"],
            "properties": {
              "reason": {"type": "string", "minLength": 1},
              "migration": {"type": "string", "minLength": 1},
              "segments": {
                "description": "The shipped segments this release may edit, by module and segment id.",
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "object",
                  "required": ["module", "segment"],
                  "properties": {
                    "module": {"$ref": "module.json#/definitions/id"},
                    "segment": {"$ref": "module.json#/definitions/id"}
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
