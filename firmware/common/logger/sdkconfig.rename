# Old Kconfig names (#93). An sdkconfig saved before the rename keeps its
# values. Format CONFIG_OLD_NAME CONFIG_NEW_NAME.
CONFIG_AQ_LOGGER_WORKER_WDT CONFIG_OS_LOGGER_WORKER_WDT
CONFIG_AQ_LOGGER_WORKER_WDT_TIMEOUT_S CONFIG_OS_LOGGER_WORKER_WDT_TIMEOUT_S
CONFIG_AQ_LOGGER_WORKER_WDT_HEALTHY_S CONFIG_OS_LOGGER_WORKER_WDT_HEALTHY_S
CONFIG_AQ_LOGGER_BENCH_STALL CONFIG_OS_LOGGER_BENCH_STALL
