menu "OpenSensor persistent diagnostics"

config OS_LOG_PERSIST_RING_BYTES
    int "PSRAM log ring bytes"
    range 4096 262144
    default 65536
    help
        Size of the no-init PSRAM log ring that LOG_TAIL streams and that
        survives a warm reboot. A board with little PSRAM lowers it in its
        sdkconfig.defaults. Used only with
        SPIRAM_ALLOW_NOINIT_SEG_EXTERNAL_MEMORY.

config OS_LOG_PERSIST_EVENT_SLOTS
    int "Disconnect event ring slots"
    range 8 255
    default 64
    help
        Number of 16 byte DisconnectEvent slots kept beside the log ring.
        DIAG sends at most 61 of them on LAN and 29 on BLE.

endmenu

menu "OpenSensor power management"

config OS_PM_DFS_MIN_MHZ
    int "DFS minimum CPU MHz"
    range 40 240
    default 80
    help
        CPU frequency with no power management lock held, applied by
        opensensor::power::configure_dfs() when the image sets PM_ENABLE. The
        ESP32-S3 accepts 40, 80, 160 or 240. At 80 MHz or more the APB clock
        stays at 80 MHz, so SPI, I2C and UART clocks do not change.

config OS_PM_DFS_MAX_MHZ
    int "DFS maximum CPU MHz"
    range 40 240
    default 240
    help
        CPU frequency while a CPU_FREQ_MAX lock is held, for example by the
        LAN task while a peer is authenticated.

endmenu
