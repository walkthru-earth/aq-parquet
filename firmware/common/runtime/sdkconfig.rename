# Old Kconfig names (#93). An sdkconfig saved before the rename keeps its
# values. Format CONFIG_OLD_NAME CONFIG_NEW_NAME.
CONFIG_AQ_LOG_PERSIST_RING_BYTES CONFIG_OS_LOG_PERSIST_RING_BYTES
CONFIG_AQ_LOG_PERSIST_EVENT_SLOTS CONFIG_OS_LOG_PERSIST_EVENT_SLOTS
CONFIG_AQ_PM_DFS_MIN_MHZ CONFIG_OS_PM_DFS_MIN_MHZ
CONFIG_AQ_PM_DFS_MAX_MHZ CONFIG_OS_PM_DFS_MAX_MHZ
