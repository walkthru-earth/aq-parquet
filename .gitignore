# pixi environments
.pixi/*
!.pixi/config.toml
backup/

# local agent / tooling state
# Agent git worktrees are created under .claude/worktrees, so ignore the lot.
.claude/
.code-review-graph/

# Firmware SDKs live in $M5_TOOLCHAIN_ROOT outside the repo, but ignore these
# defensively in case a tool ever writes one here.
.toolchains/

# Host Python bytecode
__pycache__/
*.py[cod]
exports/
# Arduino upload can also create build caches under a sketch directory.
firmware/**/build/
