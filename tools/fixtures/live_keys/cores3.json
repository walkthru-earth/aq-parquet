            "c10": "pm10_cf1_ug_m3",
            "pm1": "pm1_atmospheric_ug_m3",
            "pm25": "pm25_atmospheric_ug_m3",
            "pm10": "pm10_atmospheric_ug_m3",
            "n03": "particles_gt03_per_01l",
            "n05": "particles_gt05_per_01l",
            "n1": "particles_gt10_per_01l",
            "n25": "particles_gt25_per_01l",
            "n5": "particles_gt50_per_01l",
            "n10": "particles_gt100_per_01l",
            "imu_t": "imu_temperature_c",
            "als": "light_ch0_raw",
