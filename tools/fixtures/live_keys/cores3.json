            "n5": "particles_gt50_per_01l",
            "n10": "particles_gt100_per_01l",
            "t": "imu_temperature_c",
            "bat": "battery_mv",
            "pct": "battery_percent",
            "chg": "charging_status",
            "vbus": "vbus_mv",
            "als": "light_ch0_raw"
