{
  "board": "cores3",
  "convention": "Every field valid with integers 1 and floats 1.0, rendered by the shared emitter through tools/live_sample.h. utc is the stored microseconds times 1000 on the wire.",
  "digests": {
    "4f80c26cde8d7ea78c2160225d98386009a8651d9a049b4bf68a75da96015e94": {
      "note": "Dictionary cores3-telemetry-v6 with per field LIVE decimals (#91). Each FIELD row ends with its live_key and decimals, so this digest covers both. t prints two decimals, imu_t and rh one. Older digests are retired and no longer listed.",
