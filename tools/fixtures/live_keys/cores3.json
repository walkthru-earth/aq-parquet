          "payload": "{\"seq\":1,\"mono\":1,\"utc\":1000,\"pms\":1,\"c1\":1,\"c25\":1,\"c10\":1,\"pm1\":1,\"pm25\":1,\"pm10\":1,\"n03\":1,\"n05\":1,\"n1\":1,\"n25\":1,\"n5\":1,\"n10\":1,\"imu_t\":1.0,\"als\":1,\"vbus\":1,\"bat\":1,\"pct\":1,\"chg\":1,\"t\":1.00,\"rh\":1.0}"
        }
      ]
    }
  }
