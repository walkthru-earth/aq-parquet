{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://walkthru-earth.github.io/stac-opensensor/v0.1.0/profile.json#",
  "title": "OpenSensor Station Profile",
  "description": "Rules on top of STAC core and the OpenSensor extension for station Collections and day Items.",
  "type": "object",
  "required": [
    "type"
  ],
  "properties": {
    "type": {
      "enum": [
        "Collection",
        "Feature"
      ]
    }
  },
  "if": {
    "properties": {
      "type": {
        "const": "Collection"
      }
    }
  },
  "then": {
    "$ref": "#/definitions/stationCollection"
  },
  "else": {
    "$ref": "#/definitions/dayItem"
  },
  "definitions": {
    "stationCollection": {
      "type": "object",
      "required": [
        "type",
        "stac_extensions",
        "license",
        "keywords",
        "instruments",
        "opensensor:sample_interval_s",
        "item_assets",
        "links"
      ],
      "properties": {
        "type": {
          "const": "Collection"
        },
        "stac_extensions": {
          "allOf": [
            {
              "$ref": "#/definitions/hasTable"
            },
            {
              "$ref": "#/definitions/hasOpenSensor"
            },
            {
              "$ref": "#/definitions/hasProfile"
            }
          ]
        },
        "keywords": {
          "type": "array",
          "minItems": 1
        },
        "instruments": {
          "type": "array",
          "minItems": 1
        },
        "item_assets": {
          "type": "object",
          "required": [
            "data"
          ],
          "properties": {
            "data": {
              "$ref": "#/definitions/dataAsset"
            }
          }
        },
        "links": {
          "type": "array",
          "contains": {
            "$ref": "#/definitions/dictionaryLink"
          }
        }
      }
    },
    "dayItem": {
      "type": "object",
      "required": [
        "type",
        "stac_extensions",
        "collection",
        "properties",
        "assets"
      ],
      "properties": {
        "type": {
          "const": "Feature"
        },
        "stac_extensions": {
          "allOf": [
            {
              "$ref": "#/definitions/hasTable"
            },
            {
              "$ref": "#/definitions/hasOpenSensor"
            },
            {
              "$ref": "#/definitions/hasProfile"
            },
            {
              "contains": {
                "const": "https://stac-extensions.github.io/grid/v1.1.0/schema.json"
              }
            },
            {
              "contains": {
                "const": "https://stac-extensions.github.io/anonymized-location/v1.0.0/schema.json"
              }
            }
          ]
        },
        "properties": {
          "type": "object",
          "required": [
            "start_datetime",
            "end_datetime",
            "grid:code",
            "anon:size",
            "anon:warning"
          ],
          "properties": {
            "grid:code": {
              "type": "string",
              "pattern": "^H3-[0-9a-f]{15}$"
            }
          }
        },
        "assets": {
          "type": "object",
          "required": [
            "data"
          ],
          "properties": {
            "data": {
              "type": "object",
              "required": [
                "href",
                "type",
                "table:row_count"
              ],
              "properties": {
                "type": {
                  "const": "application/vnd.apache.parquet"
                }
              }
            }
          }
        }
      }
    },
    "hasTable": {
      "contains": {
        "const": "https://stac-extensions.github.io/table/v1.3.0/schema.json"
      }
    },
    "hasOpenSensor": {
      "contains": {
        "const": "https://walkthru-earth.github.io/stac-opensensor/v0.1.0/schema.json"
      }
    },
    "hasProfile": {
      "contains": {
        "const": "https://walkthru-earth.github.io/stac-opensensor/v0.1.0/profile.json"
      }
    },
    "dictionaryLink": {
      "type": "object",
      "required": [
        "rel",
        "href",
        "file:checksum"
      ],
      "properties": {
        "rel": {
          "const": "describedby"
        },
        "file:checksum": {
          "type": "string",
          "pattern": "^1220[0-9a-f]{64}$"
        }
      }
    },
    "dataAsset": {
      "$comment": "The data asset of a station. Also used by board templates.",
      "type": "object",
      "required": [
        "type",
        "roles",
        "table:primary_datetime",
        "table:columns"
      ],
      "properties": {
        "type": {
          "const": "application/vnd.apache.parquet"
        },
        "roles": {
          "type": "array",
          "contains": {
            "const": "data"
          }
        },
        "table:columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/column"
          }
        }
      }
    },
    "column": {
      "type": "object",
      "required": [
        "name",
        "type",
        "roles"
      ],
      "properties": {
        "roles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "enum": [
              "physicalMeasurement",
              "auxiliaryInformation",
              "qualityInformation",
              "referenceInformation",
              "coordinate",
              "modelResult"
            ]
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "roles": {
                "contains": {
                  "const": "physicalMeasurement"
                }
              }
            }
          },
          "then": {
            "required": [
              "unit",
              "opensensor:property",
              "opensensor:procedure",
              "opensensor:field_id",
              "opensensor:aggregate",
              "opensensor:valid_when"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "roles": {
                "contains": {
                  "enum": [
                    "auxiliaryInformation",
                    "qualityInformation"
                  ]
                }
              }
            }
          },
          "then": {
            "required": [
              "opensensor:procedure",
              "opensensor:field_id",
              "opensensor:aggregate"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "roles": {
                "contains": {
                  "const": "modelResult"
                }
              }
            }
          },
          "then": {
            "required": [
              "unit",
              "opensensor:derived",
              "opensensor:aggregate"
            ]
          }
        }
      ]
    }
  }
}
