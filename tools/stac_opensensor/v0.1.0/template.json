{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://walkthru-earth.github.io/stac-opensensor/v0.1.0/template.json#",
  "title": "OpenSensor Board Template",
  "description": "What a firmware build knows about its columns, keyed by the dictionary digest. Not a STAC document.",
  "type": "object",
  "required": [
    "type",
    "template_version",
    "id",
    "instruments",
    "opensensor:sample_interval_s",
    "item_assets",
    "links",
    "firmware"
  ],
  "properties": {
    "type": {
      "const": "OpenSensorTemplate"
    },
    "template_version": {
      "const": "0.1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string"
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "instruments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "opensensor:sample_interval_s": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "item_assets": {
      "type": "object",
      "required": [
        "data"
      ],
      "properties": {
        "data": {
          "allOf": [
            {
              "$ref": "profile.json#/definitions/dataAsset"
            },
            {
              "$ref": "schema.json#/definitions/tableHolder"
            },
            {
              "properties": {
                "table:columns": {
                  "items": {
                    "not": {
                      "anyOf": [
                        {
                          "required": [
                            "opensensor:scale"
                          ]
                        },
                        {
                          "required": [
                            "title"
                          ]
                        }
                      ]
                    }
                  }
                }
              }
            }
          ]
        }
      }
    },
    "links": {
      "type": "array",
      "contains": {
        "$ref": "profile.json#/definitions/dictionaryLink"
      }
    },
    "firmware": {
      "type": "object",
      "required": [
        "schema",
        "proto_min",
        "dict",
        "live_keys"
      ],
      "properties": {
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "proto_min": {
          "type": "integer",
          "minimum": 1
        },
        "dict": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "live_keys": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-z0-9_]{1,15}$"
          }
        },
        "unit_labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
