CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_FREERTOS_HZ=1000
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_FS_LOCK=16
CONFIG_FATFS_USE_FASTSEEK=y
CONFIG_FATFS_FAST_SEEK_BUFFER_SIZE=128
CONFIG_LWIP_SNTP_MAX_SERVERS=2
# A panic, including the storage worker watchdog reset, saves an ELF core dump
# (task stacks only, SHA-256 checked) to the 64 KiB coredump partition that
# every board table reserves at 0xc10000. Read it with idf.py coredump-info.
# These symbols exist only when a board component requires espcoredump, and
# tools/check_idf_target.py rejects a build that drops them.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
# The dump runs on its own internal stack. IDF adds 100 bytes to this value
# while the log level is debug, so the real buffer (s_coredump_stack) is 2660
# bytes in these images. A Waveshare task watchdog dump used 1520 bytes of the
# 1792 byte IDF default, which left 368. With 2660 about 1140 bytes stay free
# for deeper call paths, such as an encrypted flash write or extra log calls.
# The ELF writer walks tasks in a loop, so more tasks or radios add bytes to
# the partition, not depth to this stack. The diagnostic, with no PSRAM task
# stacks, would otherwise default to 0 and dump on the crashed task or ISR.
#
# Measured internal RAM cost of the dump on CoreS3 and the Waveshare logger,
# about 4.8 KB of DIRAM. The 2660 byte dump stack. 1120 bytes of ISR stack,
# since FreeRTOS raises the ISR stack from 1536 to 2096 bytes per core
# whenever the dump is enabled. About 920 bytes of port statics (register
# dump, extra info, fake stack frame, task name buffer). About 110 bytes of
# flash guard code. The diagnostic pays about 2.1 KB more, because flash
# write, erase and read code moves into IRAM, and nothing on that image wrote
# flash before.
CONFIG_ESP_COREDUMP_STACK_SIZE=2560
